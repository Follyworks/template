# Normalize line endings on commit; check out native per platform.
* text=auto eol=lf

# Windows-only scripts stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Unix shell scripts and the Gradle wrapper stay LF.
*.sh    text eol=lf
gradlew text eol=lf

# Binary assets - never touch line endings or diff as text.
*.jar   binary
*.png   binary
*.ogg   binary
*.ico   binary

# Datagen output: keep it out of language stats and collapse diffs.
src/generated/resources/** linguist-generated=true
